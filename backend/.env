# ====================================================================
# Industrial Knowledge Intelligence Platform - Environment Config
# ====================================================================

# Local LLM Configuration
# Set USE_LOCAL_LLM to True to load model weights locally.
# If you want to use the live Qwen2.5-72B-Instruct model in the cloud for free (no local VRAM limits), paste your Hugging Face Token below.
USE_LOCAL_LLM=False
LLM_MODEL_NAME="Qwen/Qwen2.5-72B-Instruct"
HF_TOKEN="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"

# Vector Store and Embeddings Configurations
# Set USE_LOCAL_EMBEDDINGS to True to download and compute embeddings and rerankers locally using CPU (BAAI/bge-large-en-v1.5 & BAAI/bge-reranker-large).
# Set to False to disable local models and fallback to Hugging Face API / mock search.
USE_LOCAL_EMBEDDINGS=False

# Tesseract OCR path configuration
# In Windows, standard path is: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD="D:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Server Port settings
PORT=8000
HOST="0.0.0.0"

# Neo4j Knowledge Graph (AuraDB Cloud)
NEO4J_ENABLED=True
NEO4J_URI=neo4j+ssc://199b1763.databases.neo4j.io
NEO4J_USERNAME=199b1763
NEO4J_PASSWORD=JCO1NjQxFo4N0JA61itHTS22MwsO4ldD3bty6-McQ40
